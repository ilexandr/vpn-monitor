<Window x:Class="VpnMonitor.Client.AwgManagementWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="AWG Dash Monitor — управление AWG" Width="820" Height="720" MinWidth="680" MinHeight="480"
 WindowStartupLocation="CenterScreen" Icon="/VpnMonitor.Client;component/Assets/AWG_Monitor.ico" Style="{StaticResource {x:Type Window}}">
 <Grid Background="{DynamicResource AppBackgroundBrush}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="{DynamicResource HeaderBackgroundBrush}" Padding="22,16">
   <DockPanel>
    <ComboBox x:Name="ThemeBox" DockPanel.Dock="Right" Width="130" Height="34" VerticalAlignment="Center" SelectionChanged="Theme_Changed">
     <ComboBoxItem Content="Светлая тема"/><ComboBoxItem Content="Тёмная тема"/>
    </ComboBox>
    <StackPanel><TextBlock Text="Управление AWG" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource HeaderTextBrush}"/>
     <TextBlock Text="Общий туннель компьютера" Foreground="{DynamicResource HeaderMutedBrush}" Margin="0,4,0,0"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid Margin="22,18">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
    <StackPanel><TextBlock x:Name="ServiceText" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="SelectedText" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/></StackPanel>
   </Border>
   <TextBlock Grid.Row="1" Margin="0,12" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"
    Text="Подключение и отключение затрагивают всех пользователей компьютера. Закрытие этого окна не отключает VPN. Для выбора другого профиля сначала остановите туннель."/>
   <ListBox Grid.Row="2" Height="140" x:Name="ProfileList" SelectionChanged="Profile_Changed" Padding="4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
    <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/></DataTemplate></ListBox.ItemTemplate>
   </ListBox>
   <Border Grid.Row="3" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,12,0,0">
    <StackPanel><TextBlock x:Name="PrimaryEndpointText" TextWrapping="Wrap"/><TextBlock x:Name="BackupEndpointText" TextWrapping="Wrap" Margin="0,5,0,0"/>
     <TextBlock x:Name="BackupAvailabilityText" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0"/>
    </StackPanel>
   </Border>
   <TextBlock Grid.Row="4" x:Name="ResultText" TextWrapping="Wrap" Margin="0,12,0,0" Foreground="{DynamicResource MutedBrush}"/>
  </Grid></ScrollViewer>
  <Border Grid.Row="2" Padding="22,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <WrapPanel x:Name="Commands" Margin="0,0,8,0">
    <Button Content="Добавить .conf" Tag="import" Click="Command_Click" Padding="12,7" Margin="0,0,8,6"/>
    <Button x:Name="SelectButton" Content="Выбрать" Tag="select" Click="Command_Click" Padding="12,7" Margin="0,0,8,6"/>
    <Button x:Name="RemoveButton" Content="Удалить" Tag="remove" Click="Command_Click" Padding="12,7" Margin="0,0,8,6"/>
    <Button x:Name="StartButton" Content="Подключить" Tag="start" Click="Command_Click" Style="{StaticResource PrimaryButtonStyle}" Padding="12,7" Margin="0,0,8,6"/>
    <Button x:Name="StopButton" Content="Отключить" Tag="stop" Click="Command_Click" Padding="12,7" Margin="0,0,8,6"/>
    <Button x:Name="EditProfileButton" Content="Конфигурация…" Tag="edit" Click="Command_Click" Padding="12,7" Margin="0,0,8,6"/>
    <Button x:Name="ConnectionSettingsButton" Content="Связь и резерв…" Tag="configure" Click="Command_Click" Padding="12,7" Margin="0,0,8,6" ToolTip="Настройки выбранного профиля; сначала отключите туннель"/>
   </WrapPanel>
   <Button Grid.Column="1" Content="Закрыть" IsCancel="True" Click="Close_Click" Padding="12,7" Margin="0,0,0,6" VerticalAlignment="Bottom"/>
   </Grid>
  </Border>
 </Grid>
</Window>
