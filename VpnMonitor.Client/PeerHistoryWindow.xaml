<Window x:Class="VpnMonitor.Client.PeerHistoryWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="История клиента" Width="760" Height="460" MinWidth="550" MinHeight="300"
 WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource TextBrush}">
 <DockPanel Margin="16">
  <TextBlock x:Name="HistoryDescription" DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,12"
    Text="История текущего сеанса: статус AWG, активная доступность и endpoint. Хранится до 2000 событий на всех клиентов. Первое наблюдение задаёт исходное состояние. При потере связи статус неизвестен."/>
  <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
   <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,10,0"/>
   <TextBox x:Name="SearchBox" TextChanged="Search_Changed" Padding="7,5" ToolTip="Поиск по всем словам: время, источник, было и стало"/>
  </DockPanel>
  <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
   <Button x:Name="CloseButton" DockPanel.Dock="Right" Content="Закрыть" IsCancel="True" Click="Close_Click" Padding="16,7"/>
   <Button x:Name="ClearButton" DockPanel.Dock="Right" Content="Очистить..." Click="Clear_Click" Padding="12,7" Margin="8,0"/>
   <Button x:Name="ExportButton" Content="Экспорт CSV..." Click="Export_Click" HorizontalAlignment="Left" Padding="16,7"/>
  </DockPanel>
  <DataGrid x:Name="HistoryGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
    Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}"
    BorderBrush="{DynamicResource BorderBrush}" HeadersVisibility="Column" ColumnHeaderHeight="34"
    GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource GridLineBrush}"
    SelectionMode="Single" SelectionUnit="FullRow" FontSize="13" RowHeaderWidth="0">
   <DataGrid.RowStyle>
    <Style TargetType="DataGridRow">
     <Setter Property="MinHeight" Value="34"/>
     <Setter Property="Background" Value="{DynamicResource RowBackgroundBrush}"/>
     <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
     <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
       <Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/>
      </Trigger>
      <Trigger Property="IsSelected" Value="True">
       <Setter Property="Background" Value="{DynamicResource SelectedRowBrush}"/>
       <Setter Property="Foreground" Value="{DynamicResource SelectedRowTextBrush}"/>
      </Trigger>
     </Style.Triggers>
    </Style>
   </DataGrid.RowStyle>
   <DataGrid.CellStyle>
    <Style TargetType="DataGridCell">
     <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Foreground}"/>
     <Setter Property="Background" Value="Transparent"/>
     <Setter Property="BorderThickness" Value="0"/>
     <Setter Property="Padding" Value="8,5"/>
     <Setter Property="VerticalContentAlignment" Value="Center"/>
     <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
     <Setter Property="Template">
      <Setter.Value>
       <ControlTemplate TargetType="DataGridCell">
        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
         <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
        </Border>
       </ControlTemplate>
      </Setter.Value>
     </Setter>
    </Style>
   </DataGrid.CellStyle>
   <DataGrid.Columns>
    <DataGridTextColumn Header="Время" Binding="{Binding LocalTime}" Width="145"/>
    <DataGridTextColumn Header="Источник" Binding="{Binding Source}" Width="135"/>
    <DataGridTextColumn Header="Было" Binding="{Binding Previous}" Width="*" MinWidth="180"/>
    <DataGridTextColumn Header="Стало" Binding="{Binding Current}" Width="*" MinWidth="180"/>
   </DataGrid.Columns>
  </DataGrid>
 </DockPanel>
</Window>
