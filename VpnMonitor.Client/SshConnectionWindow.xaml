<Window x:Class="VpnMonitor.Client.SshConnectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SSH-подключение" Width="480" Height="350" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Icon="Assets/AWG_Monitor.ico"
        Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource TextBrush}"
        SourceInitialized="Window_SourceInitialized">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="TargetText" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
        <Grid Grid.Row="1" Margin="0,16,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Логин SSH" FontWeight="SemiBold"/>
                <TextBox x:Name="UsernameBox" Height="34" Padding="8,5" Margin="0,6,0,0" MaxLength="256"
                         Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource InputForegroundBrush}"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Порт" FontWeight="SemiBold"/>
                <TextBox x:Name="PortBox" Height="34" Padding="8,5" Margin="0,6,0,0" MaxLength="5"
                         Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource InputForegroundBrush}"/>
            </StackPanel>
        </Grid>
        <TextBlock Grid.Row="2" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                   Text="Откроется консоль OpenSSH. Пароль и подтверждение ключа сервера вводятся в ней. Используются обычные настройки и ключи OpenSSH."/>
        <TextBlock Grid.Row="3" Margin="0,8,0,0" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap"
                   Text="Логин и порт сохраняются для следующего подключения. Пароли приложение не сохраняет."/>
        <TextBlock x:Name="ErrorText" Grid.Row="4" Margin="0,8,0,6" Foreground="{DynamicResource OfflineBrush}" TextWrapping="Wrap"/>
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Подключиться" IsDefault="True" Padding="14,7" Click="Connect_Click"/>
            <Button Content="Отмена" IsCancel="True" Padding="14,7" Margin="8,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>