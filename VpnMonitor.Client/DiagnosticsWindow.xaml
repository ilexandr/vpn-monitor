<Window x:Class="VpnMonitor.Client.DiagnosticsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Диагностика AWG Dash Monitor" Width="880" Height="680" MinWidth="650" MinHeight="460" WindowStartupLocation="CenterOwner"
 Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource TextBrush}">
 <DockPanel Margin="20">
  <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
   <TextBlock Text="Диагностика" FontSize="24" FontWeight="SemiBold"/>
   <TextBlock Text="Состояние API, общего туннеля и последнего обновления. Обновление сводки использует текущие данные приложения и не выполняет новых сетевых запросов." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0"/>
  </StackPanel>
  <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
   <CheckBox x:Name="IncludeLogsBox" Content="Добавить текущий и предыдущий журналы в ZIP (до 512 КБ каждого)" Margin="0,0,0,8"/>
   <TextBlock Text="Отчёт содержит адрес сервера и сведения о системе. Настройки, VPN-профили и история клиентов не добавляются. Файл сохраняется локально." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
   <TextBlock x:Name="StatusText" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
   <WrapPanel HorizontalAlignment="Right">
    <Button x:Name="LogButton" Content="Журнал" Click="Log_Click" Padding="10,7" Margin="0,0,8,6"/>
    <Button x:Name="RefreshButton" Content="Обновить сводку" Click="Refresh_Click" Padding="10,7" Margin="0,0,8,6"/>
    <Button x:Name="CopyButton" Content="Копировать" Click="Copy_Click" Padding="10,7" Margin="0,0,8,6"/>
    <Button x:Name="ExportButton" Content="Сохранить ZIP..." Click="Export_Click" Padding="10,7" Margin="0,0,8,6"/>
    <Button x:Name="CloseButton" Content="Закрыть" Click="Close_Click" IsCancel="True" Padding="10,7" Margin="0,0,0,6"/>
   </WrapPanel>
  </StackPanel>
  <TextBox x:Name="ReportText" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" FontSize="12" Padding="12" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
   Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}"/>
 </DockPanel>
</Window>
