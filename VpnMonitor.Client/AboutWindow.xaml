<Window x:Class="VpnMonitor.Client.AboutWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="О программе" Width="620" Height="520" MinWidth="500" MinHeight="400" WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource TextBrush}">
 <DockPanel Margin="22">
  <StackPanel DockPanel.Dock="Top">
   <TextBlock Text="VPN Monitor" FontSize="26" FontWeight="SemiBold"/>
   <TextBlock x:Name="VersionText" Margin="0,8,0,0"/>
   <TextBlock Text="Мониторинг клиентов VPN и управление общим туннелем AmneziaWG." TextWrapping="Wrap" Margin="0,12,0,0"/>
   <Button Content="GitHub — исходники и релизы" Click="Repository_Click" HorizontalAlignment="Left" Margin="0,12,0,12" Padding="10,6"/>
  </StackPanel>
  <StackPanel DockPanel.Dock="Bottom">
   <TextBlock x:Name="StatusText" Text="Нажмите «Проверить обновления»." TextWrapping="Wrap" Margin="0,12,0,12"/>
   <TextBlock Text="Обновление временно прервёт общий туннель и закроет VPN Monitor и менеджер во всех сеансах. После установки их работа восстановится. Windows запросит права администратора." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,12"/>
   <WrapPanel HorizontalAlignment="Right">
    <Button x:Name="CheckButton" Content="Проверить обновления" Click="Check_Click" Padding="12,7" Margin="0,0,8,0"/>
    <Button x:Name="UpdateButton" Content="Обновить" Click="Update_Click" IsEnabled="False" Padding="12,7" Margin="0,0,8,0"/>
    <Button x:Name="CloseButton" Content="Закрыть" Click="Close_Click" IsCancel="True" Padding="12,7"/>
   </WrapPanel>
  </StackPanel>
  <ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock x:Name="NotesText" TextWrapping="Wrap"/></ScrollViewer>
 </DockPanel>
</Window>
