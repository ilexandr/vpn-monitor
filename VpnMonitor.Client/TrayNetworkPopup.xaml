<Window x:Class="VpnMonitor.Client.TrayNetworkPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440"
        MaxHeight="520"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="Manual"
        Deactivated="Window_Deactivated"
        KeyDown="Window_KeyDown">
    <Border Margin="10"
            Padding="14"
            Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.35" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="СЕТЕВЫЕ ИНТЕРФЕЙСЫ"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentCyanBrush}"/>
                    <TextBlock x:Name="SummaryText"
                               Margin="0,3,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource MutedBrush}"/>
                </StackPanel>
                <Button Grid.Column="1" Width="30" Height="30" Padding="0"
                        ToolTip="Закрыть" Click="Close_Click">
                    <TextBlock Text="×" FontSize="18" Margin="0,-2,0,0"/>
                </Button>
            </Grid>

            <Border Grid.Row="1" Height="1" Margin="0,12,0,8"
                    Background="{DynamicResource BorderBrush}"/>

            <ScrollViewer Grid.Row="2" MaxHeight="330"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="InterfacesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8,7" Margin="0,1" CornerRadius="7">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Ellipse Grid.Column="0" Width="8" Height="8"
                                             HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{DynamicResource OfflineBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsUp}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource OnlineBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding InterfaceName}"
                                               Margin="0,0,12,0"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextBrush}"/>

                                    <Button Grid.Column="2"
                                            Tag="{Binding Address}"
                                            Click="CopyIp_Click"
                                            Padding="8,4"
                                            HorizontalAlignment="Right"
                                            ToolTip="Копировать IP">
                                        <TextBlock Text="{Binding Address}"
                                                   FontFamily="Consolas"
                                                   Foreground="{DynamicResource AccentCyanBrush}"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock x:Name="StatusText" Grid.Row="3"
                       Margin="2,8,2,0"
                       MinHeight="17"
                       FontSize="11"
                       Foreground="{DynamicResource CopySuccessBrush}"/>

            <Grid Grid.Row="4" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Height="34" Click="Open_Click">Открыть</Button>
                <Button Grid.Column="2" Height="34" Click="Refresh_Click">Обновить</Button>
                <Button Grid.Column="4" Height="34" Click="Settings_Click">Настройки</Button>
            </Grid>
        </Grid>
    </Border>
</Window>
