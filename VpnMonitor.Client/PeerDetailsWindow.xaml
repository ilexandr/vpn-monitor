<Window x:Class="VpnMonitor.Client.PeerDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Клиент VPN" Width="760" Height="560"
        MinWidth="620" MinHeight="440"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Icon="Assets/AWG_Monitor.ico"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        SourceInitialized="Window_SourceInitialized"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="CopyLinkStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CopySurface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CopySurface" Property="Background" Value="{DynamicResource IpHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CopySurface" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PeerActionButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="FavoriteCardButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="StarSurface" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="StarSurface" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentCyanBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False"
                          PanningMode="VerticalOnly">
                <Grid Margin="20,20,14,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <Button x:Name="NameCopyButton"
                                    Content="{Binding Name}"
                                    Tag="{Binding Name}"
                                    Style="{StaticResource CopyLinkStyle}"
                                    FontSize="22"
                                    FontWeight="SemiBold"
                                    Margin="-5,0,0,0"
                                    Click="CopyValue_Click"/>
                            <TextBlock Text="{Binding Notes}" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button x:Name="NotificationButton" Grid.Column="1" Style="{StaticResource FavoriteCardButtonStyle}"
                                Margin="10,0,0,0" VerticalAlignment="Top" Click="Notification_Click"/>
                        <Button x:Name="FavoriteButton" Grid.Column="2" Style="{StaticResource FavoriteCardButtonStyle}"
                                Margin="6,0,0,0" VerticalAlignment="Top" Click="Favorite_Click"/>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="235"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" VerticalAlignment="Top">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="125"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="42"/>
                                <RowDefinition Height="42"/>
                                <RowDefinition Height="42"/>
                                <RowDefinition Height="42"/>
                                <RowDefinition Height="42"/>
                                <RowDefinition Height="42"/>
                                <RowDefinition Height="Auto" MinHeight="42"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Статус" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" FontWeight="SemiBold" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding StatusText}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AwgState.IsCurrent}" Value="False">
                                                <Setter Property="Text" Value="Нет актуальных данных"/>
                                                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock Grid.Row="1" Text="VPN IP" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                            <Button x:Name="VpnIpCopyButton" Grid.Row="1" Grid.Column="1"
                                    Content="{Binding VpnIp}" Tag="{Binding VpnIp}"
                                    Style="{StaticResource CopyLinkStyle}"
                                    VerticalAlignment="Center" Click="CopyValue_Click"/>

                            <TextBlock Grid.Row="2" Text="External IP" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                            <Button x:Name="ExternalIpCopyButton" Grid.Row="2" Grid.Column="1"
                                    Content="{Binding EndpointHost}" Tag="{Binding EndpointHost}"
                                    Style="{StaticResource CopyLinkStyle}"
                                    VerticalAlignment="Center" Click="CopyValue_Click"/>

                            <TextBlock Grid.Row="3" Text="Handshake" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding HandshakeText, Mode=OneWay}" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="4" Text="Получено" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ReceiveText, Mode=OneWay}" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="5" Text="Отправлено" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SentText, Mode=OneWay}" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="6" Text="Группы" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Top" Margin="0,11,0,0"/>
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding GroupsText, Mode=OneWay}" TextWrapping="Wrap" VerticalAlignment="Top" Margin="0,11,0,0"/>
                        </Grid>

                        <Border Grid.Column="1" Width="1" HorizontalAlignment="Center"
                                Background="{DynamicResource BorderBrush}"/>

                        <StackPanel Grid.Column="2" VerticalAlignment="Top">
                            <Grid Margin="0,0,0,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="СЕРВИСЫ" Foreground="{DynamicResource MutedBrush}"
                                           FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                <Button x:Name="RefreshServicesButton" Grid.Column="1"
                                        Content="↻" Width="30" Height="28" Padding="0"
                                        ToolTip="Проверить сервисы еще раз"
                                        Click="RefreshServices_Click"/>
                            </Grid>

                            <Border Background="{DynamicResource InfoBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="30"/>
                                        <RowDefinition Height="30"/>
                                        <RowDefinition Height="30"/>
                                        <RowDefinition Height="30"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock x:Name="PingStatusDot" Grid.Row="0" Text="●"
                                               Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Ping" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="PingStatusText" Grid.Row="0" Grid.Column="2" Text="—"
                                               Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"
                                               HorizontalAlignment="Right"/>

                                    <TextBlock x:Name="RdpStatusDot" Grid.Row="1" Text="●"
                                               Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="RDP · 3389" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="RdpStatusText" Grid.Row="1" Grid.Column="2" Text="—"
                                               Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"
                                               HorizontalAlignment="Right"/>

                                    <TextBlock x:Name="SmbStatusDot" Grid.Row="2" Text="●"
                                               Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="SMB · 445" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="SmbStatusText" Grid.Row="2" Grid.Column="2" Text="—"
                                               Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"
                                               HorizontalAlignment="Right"/>

                                    <TextBlock x:Name="RadminStatusDot" Grid.Row="3" Text="●"
                                               Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="RadminServiceLabel" Grid.Row="3" Grid.Column="1" Text="Radmin · 4899" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="RadminStatusText" Grid.Row="3" Grid.Column="2" Text="—"
                                               Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>

                            <TextBlock Text="ДЕЙСТВИЯ" Foreground="{DynamicResource MutedBrush}"
                                       FontSize="11" FontWeight="Bold" Margin="0,2,0,10"/>
                            <Button x:Name="PingButton" Content="Пинг" Style="{StaticResource PeerActionButtonStyle}" Click="Ping_Click"/>
                            <Button x:Name="TraceButton" Content="Tracert" Style="{StaticResource PeerActionButtonStyle}" Click="Trace_Click"/>
                            <Button x:Name="RdpButton" Content="RDP" Style="{StaticResource PeerActionButtonStyle}" Click="Rdp_Click"/>
                            <Button x:Name="SshButton" Content="SSH" Style="{StaticResource PeerActionButtonStyle}" Click="Ssh_Click"/>
                            <Button x:Name="SharedFoldersButton" Content="Общие папки  ›" Style="{StaticResource PeerActionButtonStyle}" Click="SharedFolders_Click"/>

                            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,3,0,11"/>

                            <Button x:Name="RadminControlButton" Content="Radmin — Управление" Style="{StaticResource PeerActionButtonStyle}" Click="RadminControl_Click"/>
                            <Button x:Name="RadminFilesButton" Content="Radmin — Передача файлов" Style="{StaticResource PeerActionButtonStyle}" Click="RadminFiles_Click"/>
                        </StackPanel>
                    </Grid>
        </Grid>
            </ScrollViewer>

        <Border Grid.Row="1"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Background="{DynamicResource AppBackgroundBrush}"
                Padding="20,12">
            <Button Content="Закрыть"
                    Width="90"
                    Height="34"
                    HorizontalAlignment="Right"
                    IsCancel="True"/>
        </Border>
    </Grid>
</Window>
