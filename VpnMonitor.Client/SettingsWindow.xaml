<Window x:Class="VpnMonitor.Client.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Настройки VPN Monitor" Width="940" Height="740" MinWidth="760" MinHeight="420" ResizeMode="CanResize" WindowStartupLocation="CenterOwner" Icon="Assets/AWG_Monitor.ico" Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource TextBrush}" SourceInitialized="Window_SourceInitialized">
  <Window.Resources>
    <Style x:Key="SettingsNavItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource NavigationItemStyle}"/>
  </Window.Resources>
  <Grid Background="{DynamicResource AppBackgroundBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="210" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
        <DockPanel>
          <TextBlock Text="НАСТРОЙКИ" DockPanel.Dock="Top" Margin="24,24,12,8" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}" />
          <StackPanel DockPanel.Dock="Top" Margin="12,0,12,8">
 <TextBox x:Name="SettingsSearchBox" Height="34" Padding="8,5" TextChanged="SettingsSearch_Changed" ToolTip="Поиск по названиям и описаниям настроек"/>
 <TextBlock x:Name="SearchHint" Text="Поиск настроек" Foreground="{DynamicResource MutedBrush}" Margin="2,6,0,4" TextWrapping="Wrap"/>
 <ListBox x:Name="SettingsSearchResults" Visibility="Collapsed" MaxHeight="220" BorderThickness="0"
   ItemContainerStyle="{StaticResource SettingsNavItemStyle}" SelectionChanged="SearchResult_SelectionChanged">
  <ListBox.ItemTemplate>
   <DataTemplate><TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontSize="12"/></DataTemplate>
  </ListBox.ItemTemplate>
 </ListBox>
</StackPanel>
<ListBox x:Name="SettingsNavigation" Margin="12,12,12,12" SelectionChanged="SettingsNavigation_SelectionChanged" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource SettingsNavItemStyle}">
            <ListBoxItem Content="Подключение" />
            <ListBoxItem Content="Внешний вид" />
            <ListBoxItem Content="Запуск" />
            <ListBoxItem Content="Уведомления" />
            <ListBoxItem Content="Проверки доступности" />
            <ListBoxItem Content="Radmin Viewer" />
            <ListBoxItem Content="Действия" />
          </ListBox>
        </DockPanel>
      </Border>
      <ScrollViewer x:Name="SectionScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ScrollChanged="SectionScroll_ScrollChanged">
        <StackPanel x:Name="SettingsSections" Margin="24,24,24,0">
          <StackPanel x:Name="SettingsPage0" Margin="0,0,0,32">
            <TextBlock Text="Подключение" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,6" />
            <TextBlock Text="Сервер VPN Monitor и учётная запись. Прокручивайте настройки или выберите раздел слева." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,20" />
            <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
              <StackPanel>
                <StackPanel>
                  <Button Content="Профили и управление AWG..." Click="AwgManage_Click" HorizontalAlignment="Left" Padding="12,7" Margin="0,0,0,16"/>
              <Button Content="Проверить подключение" Click="Test_Click" HorizontalAlignment="Left" Margin="0,0,0,12" Padding="12,7"/>
              <TextBlock Text="Адрес VPN Monitor" FontWeight="SemiBold" />
                  <TextBox x:Name="ServerUrlBox" Height="34" Margin="0,6,0,14" Padding="8,5" ToolTip="Например: http://10.20.0.1" />
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="16" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                      <TextBlock Text="Логин" FontWeight="SemiBold" />
                      <TextBox x:Name="UsernameBox" Height="34" Margin="0,6,0,14" Padding="8,5" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="Пароль" FontWeight="SemiBold" />
                      <PasswordBox x:Name="PasswordBox" Height="34" Margin="0,6,0,14" Padding="8,5" />
                    </StackPanel>
                  </Grid>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="28" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                      <TextBlock Text="Обновление, сек." FontWeight="SemiBold" />
                      <TextBox x:Name="RefreshSecondsBox" Width="90" Height="34" Margin="0,6,0,0" Padding="8,5" />
                    </StackPanel>
                  </Grid>
                </StackPanel>
                <Border Background="{DynamicResource InfoBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,2,0,12">
                  <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}">Пароль подключения хранится в профиле текущего пользователя Windows и защищается через DPAPI.</TextBlock>
                </Border>
              </StackPanel>
            </Border>
          </StackPanel>
          <StackPanel x:Name="SettingsPage1" Margin="0,0,0,32">
            <TextBlock Text="Внешний вид" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,6" />
            <TextBlock Text="Тема приложения и колонки списка клиентов." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,20" />
            <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
              <StackPanel>
                <StackPanel Margin="0,0,0,20">
                  <TextBlock Text="Тема" FontWeight="SemiBold" />
                  <ComboBox x:Name="ThemeComboBox" Width="155" Height="34" HorizontalAlignment="Left" Margin="0,6,0,0" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource InputForegroundBrush}" BorderBrush="{DynamicResource BorderBrush}" MaxDropDownHeight="160">
                    <ComboBoxItem Content="Светлая" Tag="light" />
                    <ComboBoxItem Content="Темная" Tag="dark" />
                  </ComboBox>
                </StackPanel>
                <TextBlock Text="КОЛОНКИ ТАБЛИЦЫ" Foreground="{DynamicResource MutedBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,9" />
                <WrapPanel Margin="0,0,0,14">
                  <CheckBox x:Name="ShowStatusColumnCheckBox" Content="Статус" Margin="0,0,18,8" />
                  <CheckBox x:Name="ShowComputerColumnCheckBox" Content="Компьютер" Margin="0,0,18,8" />
                  <CheckBox x:Name="ShowVpnIpColumnCheckBox" Content="VPN IP" Margin="0,0,18,8" />
                  <CheckBox x:Name="ShowHandshakeColumnCheckBox" Content="Handshake" Margin="0,0,18,8" />
                  <CheckBox x:Name="ShowTrafficColumnCheckBox" Content="Трафик" Margin="0,0,18,8" />
                  <CheckBox x:Name="ShowGroupsColumnCheckBox" Content="Группы" Margin="0,0,18,8" />
                </WrapPanel>
              </StackPanel>
            </Border>
          </StackPanel>
          <StackPanel x:Name="SettingsPage2" Margin="0,0,0,32">
            <TextBlock Text="Запуск приложения" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,6" />
            <TextBlock Text="Автозапуск и поведение при старте Windows." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,20" />
            <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
              <StackPanel>
                <StackPanel>
                  <CheckBox x:Name="AutostartCheckBox" Content="Запускать VPN Monitor при входе в Windows" Margin="0,2,0,2" VerticalAlignment="Center" />
                  <CheckBox x:Name="StartMinimizedCheckBox" Content="Запускать свернутым в трей" Margin="0,8,0,2" VerticalAlignment="Center" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
          <StackPanel x:Name="SettingsPage3" Margin="0,0,0,32">
            <TextBlock Text="Уведомления" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,6" />
            <TextBlock Text="События Online/Offline для выбранных клиентов." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,20" />
            <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
              <StackPanel>
                <StackPanel Margin="0,0,0,2">
                  <CheckBox x:Name="StatusNotificationsEnabledCheckBox" Content="Показывать уведомления Online/Offline для выбранных клиентов" Margin="0,2,0,2" />
                  <WrapPanel Margin="28,8,0,0">
                    <CheckBox x:Name="NotifyWhenOnlineCheckBox" Content="Online" Margin="0,0,20,6" />
                    <CheckBox x:Name="NotifyWhenOfflineCheckBox" Content="Offline" Margin="0,0,20,6" />
                  </WrapPanel>
                  <TextBlock Text="Источник уведомлений" FontWeight="SemiBold" Margin="0,8,0,0" />
                  <ComboBox x:Name="NotificationSourceBox" Height="34" Margin="0,6,0,10" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource InputForegroundBrush}">
                    <ComboBoxItem Content="Активная проверка (ping / TCP)" />
                    <ComboBoxItem Content="Статус AWG" />
                  </ComboBox>
                  <TextBlock Margin="28,2,0,0" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Text="Клиенты для наблюдения выбираются через контекстное меню или карточку клиента." />
                  <Button x:Name="TestNotificationButton" Content="Проверить уведомление Windows" Click="TestNotification_Click" HorizontalAlignment="Left" Padding="12,7" Margin="0,16,0,8"/>
                  <Button x:Name="MonitoringRulesButton" Content="Задержки, тишина и обслуживание групп…" Click="MonitoringRules_Click" HorizontalAlignment="Left" Padding="12,7" Margin="0,0,0,10"/>
                  <TextBlock x:Name="TestNotificationText" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Text="Отправляет одно тестовое сообщение без изменения состояния клиентов."/>
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
          <StackPanel x:Name="SettingsPage4" Margin="0,0,0,32">
            <TextBlock Text="Проверки доступности" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,6" />
            <TextBlock Text="Проверка VPN IP с этого компьютера." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,20" />
            <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
              <StackPanel>
                <CheckBox x:Name="ActiveChecksEnabledBox" Content="Проверять VPN IP клиентов с этого компьютера" Margin="0,2,0,8" />
                <Button x:Name="MonitoringProfilesButton" Content="Профили TCP-сервисов…" Click="MonitoringProfiles_Click" HorizontalAlignment="Left" Padding="12,7" Margin="0,0,0,14"/>
                <CheckBox x:Name="ActiveChecksWatchedOnlyBox" Content="Только клиенты с включёнными уведомлениями" Margin="0,0,0,8" />
                <TextBlock Text="Интервал проверки, сек. (2–300)" FontWeight="SemiBold" />
                <TextBox x:Name="ActiveCheckSecondsBox" Width="90" Height="34" HorizontalAlignment="Left" Padding="8,5" Margin="0,6,0,10" />
                <CheckBox x:Name="ActiveCheckTcpFallbackBox" Content="Если ping не отвечает, проверить TCP-порт" Margin="0,0,0,8" />
                <TextBlock Text="Резервный TCP-порт (например: Radmin 4899, RDP 3389)" TextWrapping="Wrap" FontWeight="SemiBold" />
                <TextBox x:Name="ActiveCheckTcpPortBox" Width="90" Height="34" HorizontalAlignment="Left" Padding="8,5" Margin="0,6,0,8" />
                <TextBlock Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Text="Отключение подтверждается после 3 неудачных циклов. Если сервер недоступен, уведомления о потере клиентов подавляются. Нет ответа ping — не обязательно выключенный компьютер. Общие счётчики и фильтры Online/Offline используют статус AWG." />
                <CheckBox x:Name="SavePeerHistoryBox" Content="Сохранять историю клиентов между запусками" Margin="0,18,0,8"/>
                <TextBlock Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Text="До 7 дней и 2000 событий на сервер и аккаунт. Архив защищён текущим пользователем Windows. Отключение удаляет сохранённые архивы этого пользователя; история текущего сеанса остаётся."/>
              </StackPanel>
            </Border>
          </StackPanel>
          <StackPanel x:Name="SettingsPage5" Margin="0,0,0,32">
            <TextBlock Text="Radmin Viewer" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,6" />
            <TextBlock Text="Программа просмотра и параметры подключения." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,20" />
            <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
              <StackPanel>
                <StackPanel Margin="0,0,0,14">
                  <TextBlock Text="Путь к Radmin.exe" FontWeight="SemiBold" />
                  <Grid Margin="0,6,0,10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="8" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="RadminPathBox" Grid.Column="0" Height="34" Padding="8,5" ToolTip="Можно оставить пустым — VPN Monitor попробует найти Radmin Viewer автоматически" />
                    <Button Grid.Column="2" Content="Обзор..." Width="82" Height="34" Click="RadminBrowse_Click" />
                  </Grid>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="160" />
                      <ColumnDefinition Width="16" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                      <TextBlock Text="Порт Radmin Server" FontWeight="SemiBold" />
                      <TextBox x:Name="RadminPortBox" Width="90" Height="34" HorizontalAlignment="Left" Margin="0,6,0,0" Padding="8,5" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="Логин по умолчанию" FontWeight="SemiBold" />
                      <TextBox x:Name="RadminUsernameBox" Height="34" Margin="0,6,0,0" Padding="8,5" ToolTip="Например: Admin" />
                    </StackPanel>
                  </Grid>
                  <CheckBox x:Name="RadminAutofillUsernameCheckBox" Content="Автоматически подставлять логин в окне Radmin" Margin="0,12,0,0" VerticalAlignment="Center" />
                  <TextBlock Margin="28,5,0,0" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Text="VPN Monitor подставляет только логин. Пароль остается в окне Radmin и автоматически не сохраняется." />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
          <StackPanel x:Name="SettingsPage6" Margin="0,0,0,32" MinHeight="{Binding ViewportHeight, ElementName=SectionScroll}">
            <TextBlock Text="Действия с клиентами" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,6" />
            <TextBlock Text="Встроенные инструменты и собственные команды в одном меню." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,20" />
            <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
              <StackPanel>
                <StackPanel>
                  <TextBlock Text="МЕНЮ КЛИЕНТА" Foreground="{DynamicResource MutedBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,9" />
                  <TextBlock Text="Название, группа, порядок и видимость встроенных команд. Свои программы поддерживают аргументы с {ip}." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,10" />
                  <Button Content="Настроить действия..." Click="CustomActions_Click" HorizontalAlignment="Left" Padding="12,7" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>
    <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Background="{DynamicResource AppBackgroundBrush}" Padding="22,12">
      <StackPanel>
        <TextBlock x:Name="TestStatus" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Orientation="Horizontal">

 <Button Content="Импорт..." Height="34" Padding="10,4" Click="Import_Click" Margin="0,0,6,0"/>
 <Button Content="Экспорт..." Height="34" Padding="10,4" Click="Export_Click" ToolTip="Экспорт сохранённых настроек без пароля"/>
</StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Отмена" Width="90" Height="34" Margin="0,0,8,0" IsCancel="True" />
            <Button Style="{StaticResource PrimaryButtonStyle}" Content="Сохранить" Width="100" Height="34" IsDefault="True" Click="Save_Click" />
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>
  </Grid>
</Window>
