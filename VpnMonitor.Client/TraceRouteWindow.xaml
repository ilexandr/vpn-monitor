<Window x:Class="VpnMonitor.Client.TraceRouteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VPN Monitor — Tracert" Width="780" Height="480" MinWidth="620" MinHeight="360"
        WindowStartupLocation="CenterOwner" Icon="Assets/AWG_Monitor.ico"
        Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource TextBrush}"
        SourceInitialized="Window_SourceInitialized" Loaded="Window_Loaded" Closed="Window_Closed">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="PeerTitle" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="TargetText" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,12"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Максимум узлов:" VerticalAlignment="Center"/>
            <TextBox x:Name="MaxHopsBox" Text="30" Width="55" Padding="6,5" Margin="8,0,12,0"
                     Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource InputForegroundBrush}"/>
            <Button x:Name="StartButton" Content="Повторить" Padding="14,6" Click="Start_Click"/>
            <Button x:Name="StopButton" Content="Остановить" Padding="14,6" Margin="8,0,0,0" Click="Stop_Click"/>
        </StackPanel>
        <DataGrid x:Name="HopsGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
                  Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource TextBrush}"
                  BorderBrush="{DynamicResource BorderBrush}" GridLinesVisibility="None"
                  RowBackground="{DynamicResource AppBackgroundBrush}"
                  AlternatingRowBackground="{DynamicResource FilterGroupBackgroundBrush}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="№" Binding="{Binding Number}" Width="40"/>
                <DataGridTextColumn Header="IP узла" Binding="{Binding Address}" Width="*"/>
                <DataGridTextColumn Header="1" Binding="{Binding First}" Width="70"/>
                <DataGridTextColumn Header="2" Binding="{Binding Second}" Width="70"/>
                <DataGridTextColumn Header="3" Binding="{Binding Third}" Width="70"/>
                <DataGridTextColumn Header="Результат" Binding="{Binding Note}" Width="170"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="3" Margin="0,10,0,0">
            <TextBlock x:Name="RunStatus" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
            <TextBlock Text="3 ICMP-запроса на узел • Таймаут 1 сек. • * — нет ответа (возможна фильтрация ICMP)"
                       Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
        </StackPanel>
    </Grid>
</Window>