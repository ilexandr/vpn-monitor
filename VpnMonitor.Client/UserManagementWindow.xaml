<Window x:Class="VpnMonitor.Client.UserManagementWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Управление пользователями" Width="920" Height="650" MinWidth="720" MinHeight="460" WindowStartupLocation="CenterOwner" Style="{StaticResource {x:Type Window}}">
 <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,16"><Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="Обновить" Click="Refresh_Click" Padding="12,7"/>
   <StackPanel><TextBlock Text="Пользователи мониторинга" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Управление общей серверной базой · права admin" Foreground="{DynamicResource MutedBrush}" Margin="0,5,12,0"/></StackPanel>
  </DockPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <DockPanel><Button x:Name="NewButton" DockPanel.Dock="Bottom" Content="Новый пользователь" Click="New_Click" Padding="12,7" Margin="0,10,0,0"/>
    <ListBox x:Name="UsersList" SelectionChanged="User_Changed" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
     <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="3"><TextBlock Text="{Binding Username}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Description}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </DockPanel>
   <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock x:Name="EditorTitle" Text="Новый пользователь" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,12"/>
    <TextBlock Text="Имя определяет доступ к одноимённой группе WGDashboard. Создание аккаунта не создаёт группу или VPN-клиента." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,14"/>
    <TextBlock x:Name="AdminHint" Text="Администратор защищён. Его учётная запись управляется конфигурацией сервера." Visibility="Collapsed" TextWrapping="Wrap" Margin="0,0,0,14"/>
    <StackPanel x:Name="EditorFields">
     <TextBlock Text="Имя / группа"/><TextBox x:Name="NameBox" MaxLength="80" Padding="8,6" Margin="0,5,0,6"/>
     <ComboBox x:Name="GroupChoices" SelectionChanged="Group_Changed" Margin="0,0,0,10" ToolTip="Выбрать имя из существующих групп"/>
     <TextBlock x:Name="GroupHint" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,12"/>
     <TextBlock Text="Пароль"/><PasswordBox x:Name="PasswordBox" MaxLength="256" Padding="8,6" Margin="0,5,0,6"/>
     <TextBlock x:Name="PasswordHint" Text="Для нового аккаунта задайте пароль." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,14"/>
     <CheckBox x:Name="EnabledBox" Content="Разрешить вход" IsChecked="True" Margin="0,0,0,16"/>
     <WrapPanel><Button x:Name="SaveButton" Content="Создать" Click="Save_Click" Style="{StaticResource PrimaryButtonStyle}" Padding="12,7" Margin="0,0,8,8"/>
      <Button x:Name="DeleteButton" Content="Удалить…" Click="Delete_Click" Padding="12,7" Margin="0,0,8,8"/>
      <Button Content="Отмена изменений" Click="Reset_Click" Padding="12,7" Margin="0,0,0,8"/>
     </WrapPanel>
    </StackPanel>
   </StackPanel></ScrollViewer>
  </Grid>
  <TextBlock Grid.Row="2" x:Name="StatusText" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,14,0,0"/>
  <Button Grid.Row="3" Content="Закрыть" IsCancel="True" Click="Close_Click" HorizontalAlignment="Right" Padding="16,8" Margin="0,14,0,0"/>
 </Grid>
</Window>
