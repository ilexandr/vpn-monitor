<Window x:Class="VpnMonitor.Client.CustomActionsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Пользовательские действия" Width="700" Height="550" MinWidth="600" MinHeight="450"
 WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource TextBrush}">
<Window.Resources>
    <Style x:Key="ActionListItemStyle" TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="12,11" />
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="3" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="Accent" Background="{DynamicResource AccentCyanBrush}" CornerRadius="1" Visibility="Hidden" />
                <ContentPresenter Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center" />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource RowHoverBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource SidebarSelectedBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource SidebarSelectedTextBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter TargetName="Accent" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                <Setter TargetName="Surface" Property="BorderThickness" Value="1" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
 <Grid Margin="18">
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <DockPanel>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
     <Button Content="Добавить" Click="Add_Click" Padding="8,6"/>
     <Button Content="Удалить" Click="Remove_Click" Padding="8,6" Margin="6,0,0,0"/>
    </StackPanel>
    <ListBox x:Name="ActionsList" SelectionChanged="Selection_Changed" ItemContainerStyle="{StaticResource ActionListItemStyle}"
 BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="4" HorizontalContentAlignment="Stretch">
 <ListBox.ItemTemplate>
  <DataTemplate>
   <StackPanel>
    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
    <TextBlock Text="{Binding Group}" FontSize="11" Opacity="0.75" Margin="0,3,0,0" TextWrapping="Wrap"/>
   </StackPanel>
  </DataTemplate>
 </ListBox.ItemTemplate>
</ListBox>
   </DockPanel>
   <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
    <StackPanel x:Name="Editor">
     <TextBlock Text="Название"/>
     <TextBox x:Name="NameBox" Margin="0,6,0,12" Padding="6"/>
     <TextBlock Text="Группа (пусто — без группы)"/>
     <TextBox x:Name="GroupBox" Margin="0,6,0,6" Padding="6" ToolTip="Введите название новой группы. Одинаковые названия объединяют действия."/>
     <ComboBox x:Name="GroupChoices" IsEditable="False" SelectionChanged="GroupChoices_SelectionChanged" Margin="0,0,0,6" Padding="6"/>
     <TextBlock Text="Новую группу впишите в поле выше, существующую выберите из списка. Пустое поле — без группы." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,12"/>
     <TextBlock Text="Программа (.exe)"/>
     <TextBox x:Name="ExecutableBox" Margin="0,6,0,6" Padding="6"/>
     <Button Content="Обзор..." HorizontalAlignment="Left" Click="Browse_Click" Padding="10,5" Margin="0,0,0,12"/>
     <TextBlock Text="Аргументы — каждый с новой строки"/>
     <TextBox x:Name="ArgumentsBox" AcceptsReturn="True" Height="130" VerticalScrollBarVisibility="Auto" Margin="0,6,0,10" Padding="6"/>
     <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"
       Text="Вместо {ip} подставляется VPN IP выбранного клиента. Кавычки вокруг аргумента с пробелами не нужны. Например: /v:{ip} для mstsc.exe. Действие запускается только по вашему нажатию."/>
    </StackPanel>
   </ScrollViewer>
  </Grid>
  <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
   <Button Content="Отмена" IsCancel="True" Padding="16,7" Margin="0,0,8,0"/>
   <Button Content="Сохранить" Click="Save_Click" Padding="16,7"/>
  </StackPanel>
 </Grid>
</Window>