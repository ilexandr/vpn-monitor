<Window x:Class="VpnMonitor.Client.CustomActionsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Действия с клиентами" Width="940" Height="680" MinWidth="780" MinHeight="500"
 WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource TextBrush}">
<Window.Resources>
    <Style x:Key="ActionListItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource NavigationItemStyle}">
      <Style.Triggers><DataTrigger Binding="{Binding Enabled}" Value="False"><Setter Property="Opacity" Value="0.5"/></DataTrigger></Style.Triggers>
    </Style>
  </Window.Resources>
 <Border Background="{DynamicResource AppBackgroundBrush}" Padding="18"><Grid>
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <DockPanel>
    <WrapPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
     <Button Content="Добавить" Click="Add_Click" Padding="8,6" Margin="0,0,6,6"/>
     <Button x:Name="RemoveButton" Content="Удалить" Click="Remove_Click" Padding="8,6" Margin="0,0,6,6"/>
     <Button Content="↑" Click="MoveUp_Click" Padding="8,6" Margin="0,0,6,6" ToolTip="Выше среди команд того же типа"/>
     <Button Content="↓" Click="MoveDown_Click" Padding="8,6" Margin="0,0,6,6" ToolTip="Ниже среди команд того же типа"/>
     <Button Content="Вернуть встроенные по умолчанию" Click="Restore_Click" Padding="8,6" Margin="0,0,0,6"/>
    </WrapPanel>
    <ListBox x:Name="ActionsList" SelectionChanged="Selection_Changed" ItemContainerStyle="{StaticResource ActionListItemStyle}"
 BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="4" HorizontalContentAlignment="Stretch">
 <ListBox.ItemTemplate>
  <DataTemplate>
   <StackPanel>
    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
    <TextBlock Text="{Binding Group}" FontSize="11" Opacity="0.75" Margin="0,3,0,0" TextWrapping="Wrap"/>
   </StackPanel>
  </DataTemplate>
 </ListBox.ItemTemplate>
</ListBox>
   </DockPanel>
   <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
    <StackPanel x:Name="Editor">
     <TextBlock Text="Меню клиента" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,10"/>
     <TextBlock x:Name="ActionKindText" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,16"/>
     <CheckBox x:Name="EnabledBox" Content="Показывать в меню клиента" Margin="0,0,0,16"/>
     <TextBlock Text="Название"/>
     <TextBox x:Name="NameBox" Margin="0,6,0,12" Padding="6"/>
     <TextBlock Text="Группа (пусто — без группы)"/>
     <TextBox x:Name="GroupBox" Margin="0,6,0,6" Padding="6" ToolTip="Введите название новой группы. Одинаковые названия объединяют действия."/>
     <ComboBox x:Name="GroupChoices" IsEditable="False" SelectionChanged="GroupChoices_SelectionChanged" Margin="0,0,0,6" Padding="6"/>
     <TextBlock Text="Новую группу впишите в поле выше, существующую выберите из списка. Пустое поле — без группы." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,12"/>
     <StackPanel x:Name="ProgramEditor">
     <TextBlock Text="Программа (.exe)"/>
     <TextBox x:Name="ExecutableBox" Margin="0,6,0,6" Padding="6"/>
     <Button Content="Обзор..." HorizontalAlignment="Left" Click="Browse_Click" Padding="10,5" Margin="0,0,0,12"/>
     <TextBlock Text="Аргументы — каждый с новой строки"/>
     <TextBox x:Name="ArgumentsBox" AcceptsReturn="True" Height="130" VerticalScrollBarVisibility="Auto" Margin="0,6,0,10" Padding="6"/>
     <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"
       Text="Вместо {ip} подставляется VPN IP выбранного клиента. Кавычки вокруг аргумента с пробелами не нужны. Например: /v:{ip} для mstsc.exe. Действие запускается только по вашему нажатию."/>
     </StackPanel>
    </StackPanel>
   </ScrollViewer>
  </Grid>
  <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
   <Button Content="Сохранить" Style="{StaticResource PrimaryButtonStyle}" Click="Save_Click" Padding="16,7"/>
   <Button Content="Отмена" IsCancel="True" Padding="16,7" Margin="8,0,0,0"/>
  </StackPanel>
 </Grid></Border>
</Window>
