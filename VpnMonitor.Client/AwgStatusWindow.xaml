<Window x:Class="VpnMonitor.Client.AwgStatusWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Общий туннель AWG" Width="650" Height="540" MinWidth="580" MinHeight="460" WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource TextBrush}">
  <DockPanel Margin="22">
    <Button DockPanel.Dock="Bottom" x:Name="CloseButton" Content="Закрыть" IsCancel="True" Click="Close_Click" HorizontalAlignment="Right" Padding="14,7" Margin="0,14,0,0" />
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="Общий туннель AWG" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,18" />
        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
          <StackPanel>
            <TextBlock x:Name="ServiceStatus" Text="Проверка..." FontSize="18" FontWeight="SemiBold" />
            <TextBlock x:Name="SelectedProfileText" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0" />
            <TextBlock x:Name="HealthText" TextWrapping="Wrap" Margin="0,8,0,0" />
            <TextBlock x:Name="DetailsText" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
          </StackPanel>
        </Border>
        <TextBlock Text="Добавленные профили" FontWeight="SemiBold" Margin="0,14,0,8" />
        <ListBox x:Name="ProfilesList" Height="90" IsHitTestVisible="False" Focusable="False" Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" Padding="8,5" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <Button Content="Добавление и управление..." Click="ManagementInfo_Click" HorizontalAlignment="Left" Padding="12,7" Margin="0,12,0,0" />
        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,14,0,0" Text="Служба общая для всех сеансов Windows. Окно показывает состояние без изменения сети. Закрытие приложения не отключает туннель. «Работает» не гарантирует handshake и доступность VPN-сервера." />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>