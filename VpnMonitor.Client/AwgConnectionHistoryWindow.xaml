<Window x:Class="VpnMonitor.Client.AwgConnectionHistoryWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="История общего туннеля" Width="960" Height="460" MinWidth="550" MinHeight="300"
 WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource TextBrush}">
 <DockPanel Margin="16">
  <TextBlock DockPanel.Dock="Top" Text="Последние 200 событий общей службы. История сохраняется между запусками; включает автоматические переключения и результаты ручной проверки резерва. Данные общие для всех профилей и сеансов Windows." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,12"/>
  <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
   <Button DockPanel.Dock="Right" Content="Закрыть" IsCancel="True" Click="Close_Click" Padding="16,7"/>
   <TextBlock x:Name="SummaryText" TextWrapping="Wrap" VerticalAlignment="Center"/>
  </DockPanel>
  <DataGrid x:Name="HistoryGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
    Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}"
    BorderBrush="{DynamicResource BorderBrush}" HeadersVisibility="Column" ColumnHeaderHeight="34"
    GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource GridLineBrush}"
    SelectionMode="Single" SelectionUnit="FullRow" FontSize="13" RowHeaderWidth="0">
   <DataGrid.RowStyle>
    <Style TargetType="DataGridRow">
     <Setter Property="MinHeight" Value="34"/>
     <Setter Property="Background" Value="{DynamicResource RowBackgroundBrush}"/>
     <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
     <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
       <Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/>
      </Trigger>
      <Trigger Property="IsSelected" Value="True">
       <Setter Property="Background" Value="{DynamicResource SelectedRowBrush}"/>
       <Setter Property="Foreground" Value="{DynamicResource SelectedRowTextBrush}"/>
      </Trigger>
     </Style.Triggers>
    </Style>
   </DataGrid.RowStyle>
   <DataGrid.CellStyle>
    <Style TargetType="DataGridCell">
     <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Foreground}"/>
     <Setter Property="Background" Value="Transparent"/>
     <Setter Property="BorderThickness" Value="0"/>
     <Setter Property="Padding" Value="8,5"/>
     <Setter Property="VerticalContentAlignment" Value="Center"/>
     <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
     <Setter Property="Template">
      <Setter.Value>
       <ControlTemplate TargetType="DataGridCell">
        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
         <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
        </Border>
       </ControlTemplate>
      </Setter.Value>
     </Setter>
    </Style>
   </DataGrid.CellStyle>
   <DataGrid.Columns>
    <DataGridTextColumn Header="Время" Binding="{Binding LocalTime}" Width="125"/>
    <DataGridTextColumn Header="Endpoint" Binding="{Binding Endpoint}" Width="180"/>
    <DataGridTextColumn Header="Событие" Binding="{Binding Description}" Width="*" MinWidth="350"/>
   </DataGrid.Columns>

  </DataGrid>
 </DockPanel>
</Window>
